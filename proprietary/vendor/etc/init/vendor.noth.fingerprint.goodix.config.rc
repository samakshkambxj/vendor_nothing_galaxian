on post-fs-data
    chown system system /dev/goodix_fp
    chmod 0660 /dev/goodix_fp
    chmod 0666 /sys/panel_feature/fp_status
    chown system system /sys/devices/platform/display_id/brightnessid
    chmod 0666 /sys/devices/platform/display_id/brightnessid
    mkdir /data/vendor/fpdump/
    chmod 0777 /data/vendor/fpdump/

